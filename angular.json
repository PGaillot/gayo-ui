{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gayo-lib": {
      "projectType": "library",
      "root": "projects/gayo-lib",
      "sourceRoot": "projects/gayo-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/gayo-lib/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/gayo-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/gayo-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/gayo-lib/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/gayo-lib/src/assets",
                "output": "storybook-static/assets"
              }
            ],
            "configDir": "projects/gayo-lib/.storybook",
            "browserTarget": "gayo-lib:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/gayo-lib"],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/gayo-lib/.storybook",
            "browserTarget": "gayo-lib:build",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/gayo-lib"],
            "outputDir": "storybook-static",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/gayo-lib/src/assets",
                "output": "storybook-static/assets"
              }
            ]
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "style": "scss"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
